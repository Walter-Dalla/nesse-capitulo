    text id PK
    text user_id FK
    integer expires_at
    integer ad_unlocked
  }
  books {
    text id PK
    text source
    text source_id
    text title
    text authors
    text isbn13
    text cover_ref
    text description
  }
  user_books {
    text id PK
    text user_id FK
    text book_id FK
    text status
    integer rating
    text finished_at
    integer read_year
    integer current_page
  }
  book_comments {
    text id PK
    text item_id FK
    text user_id FK
    text body
    text visibility
  }
  friendships {
    text user_low PK, FK
    text user_high PK, FK
  }
  friend_invites {
    text code PK
    text inviter_id FK
    text used_by FK
  }
  user_blocks {
    text blocker_id PK, FK
    text blocked_id PK, FK
  }
  content_reports {
    text id PK
    text reporter_id FK
    text reported_user_id FK
    text comment_id FK
    text comment_body
    text reason
