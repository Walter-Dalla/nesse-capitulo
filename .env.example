# Porta do servidor HTTP
PORT=3000
# URL pública (usada no redirect do Google OAuth). Em dev com o Vite: http://localhost:5173
BASE_URL=http://localhost:5173
# Caminho do arquivo SQLite
DATABASE_PATH=./data/estante.db

# Credenciais OAuth 2.0 do Google (console.cloud.google.com → APIs e serviços → Credenciais)
# Tipo "Aplicativo da Web"; URI de redirecionamento autorizado: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (opcional) IDs de cliente Android/iOS aceitos no login nativo via POST /auth/google/token
GOOGLE_EXTRA_CLIENT_IDS=

# (opcional) chave da Google Books API para aumentar a cota de busca
GOOGLE_BOOKS_API_KEY=

# Habilita o botão "Entrar em modo dev" (sem Google). NUNCA em produção.
ALLOW_DEV_LOGIN=true

# Monetização: exige assistir um anúncio (uma vez por sessão logada) para criar livros.
ADS_ENABLED=false
# simulated (dev) | adsense (Google Ad Placement API, rewarded ads na web/PWA/TWA)
AD_PROVIDER=simulated
# ID do publisher AdSense (ca-pub-XXXXXXXXXXXXXXXX), usado quando AD_PROVIDER=adsense
ADSENSE_CLIENT_ID=
